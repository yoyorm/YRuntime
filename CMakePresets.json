{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "debug",
            "displayName": "Debug（日常开发）",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "YR_ENABLE_ASSERTS": "ON",
                "YR_ENABLE_LOG": "ON",
                "YR_ENABLE_DEBUG_LOG": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release（性能测试 / 录屏）",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "YR_ENABLE_ASSERTS": "OFF",
                "YR_ENABLE_LOG": "ON",
                "YR_ENABLE_DEBUG_LOG": "OFF"
            }
        },
        {
            "name": "asan",
            "displayName": "ASan + UBSan（提交前跑）",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "YR_ENABLE_SANITIZERS": "ON",
                "YR_ENABLE_ASSERTS": "ON",
                "YR_ENABLE_LOG": "ON",
                "YR_ENABLE_DEBUG_LOG": "ON"
            }
        },
        {
            "name": "benchmark",
            "displayName": "Benchmark（手动性能实验）",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "YR_BUILD_TESTS": "OFF",
                "YR_BUILD_BENCHMARKS": "ON",
                "YR_ENABLE_ASSERTS": "OFF",
                "YR_ENABLE_LOG": "OFF",
                "YR_ENABLE_DEBUG_LOG": "OFF"
            }
        },
        {
            "name": "debug-vk",
            "displayName": "Debug + Vulkan 后端",
            "inherits": "debug",
            "cacheVariables": {
                "YR_BUILD_VULKAN_BACKEND": "ON"
            }
        },
        {
            "name": "release-vk",
            "displayName": "Release + Vulkan 后端",
            "inherits": "release",
            "cacheVariables": {
                "YR_BUILD_VULKAN_BACKEND": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "benchmark",
            "configurePreset": "benchmark",
            "targets": [
                "YrBench_slot_map"
            ]
        },
        {
            "name": "debug-vk",
            "configurePreset": "debug-vk"
        },
        {
            "name": "release-vk",
            "configurePreset": "release-vk"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug-vk",
            "configurePreset": "debug-vk",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
